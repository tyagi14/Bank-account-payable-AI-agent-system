    "historical_payments": {"database": "ledger", "classification": "RestrictedFinancial", "description": "Payment history per vendor (USAspending awards plus settled ledger payments)"},
    "journal_entries": {"database": "ledger", "classification": "RestrictedFinancial", "description": "Double-entry journal headers"},
    "postings": {"database": "ledger", "classification": "RestrictedFinancial", "description": "Double-entry postings (balances derive from these)"}
  }
}
