{
  "classificationLevels": {"public": 0, "internal": 1, "RestrictedFinancial": 2},
  "agents": {
    "extraction": {"trustTier": "untrusted-input", "clearance": 1},
    "risk-scoring": {"trustTier": "internal", "clearance": 2},
    "approval": {"trustTier": "internal", "clearance": 1},
    "payment-execution": {"trustTier": "privileged", "clearance": 2}
  },
  "dataAssets": {
    "invoice_inbox": {"database": "custodian", "classification": "internal", "description": "Incoming invoice documents (real SROIE/CORD receipts) and their ground-truth fields"},
