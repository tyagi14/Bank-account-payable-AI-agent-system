<!-- Langfuse reads only its own tables. ClickHouse's self-monitoring logs and sampling profilers
     cost several cores at idle on a laptop-sized VM, so they are switched off. -->
<clickhouse>
    <logger><level>warning</level></logger>
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <part_log remove="1"/>
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <blob_storage_log remove="1"/>
</clickhouse>
