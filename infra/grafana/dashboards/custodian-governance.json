        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (principal) (increase(policy_decisions_total{decision=\"deny\"}[$__range]))",
          "legendFormat": "{{principal}}",
          "datasource": {
            "type": "prometheus",
